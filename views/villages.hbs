<section class="container section">
  <h1 class="page-title">{{t "villagesPage.title"}}</h1>
  <p class="page-subtitle">{{t "villagesPage.subtitle"}}</p>

  <div class="row villages-grid">
    {{#each villages}}
      <div class="col s12 m6 l4">
        <article class="card village-card">
          <div class="card-image">
            <img src="{{image}}" alt="{{name}}" />
          </div>
          <div class="card-content">
            <span class="card-title">{{name}}</span>
            <p>{{description}}</p>
            <p><strong>{{t "villagesPage.housesCount"}}</strong> {{housesCount}}</p>
          </div>
          <div class="card-action">
            <a class="learn-more" href="/villages/{{slug}}">
              <span class="circle" aria-hidden="true">
                <span class="icon arrow"></span>
              </span>
              <span class="button-text">{{t "villagesPage.details"}}</span>
            </a>
          </div>
        </article>
      </div>
    {{/each}}
  </div>
</section>

<section class="container section">
  <h2 class="section-title">{{t "villagesPage.mapTitle"}}</h2>
  <div class="map-block" id="yandex-map-placeholder">
    <p>{{t "villagesPage.mapPlaceholder"}}</p>
  </div>
</section>

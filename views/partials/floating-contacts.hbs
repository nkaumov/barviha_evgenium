<div class="floating-contacts">
  <a class="btn-floating green" href="{{contact.whatsappUrl}}" target="_blank" rel="noopener noreferrer" aria-label="{{t "floatingContacts.ariaWhatsapp"}}">
    <i class="material-icons">chat</i>
  </a>
  <a class="btn-floating light-blue darken-1" href="{{contact.telegramUrl}}" target="_blank" rel="noopener noreferrer" aria-label="{{t "floatingContacts.ariaTelegram"}}">
    <i class="material-icons">send</i>
  </a>
  <a class="btn-floating deep-orange" href="{{contact.phoneHref}}" aria-label="{{t "floatingContacts.ariaHotline"}}">
    <i class="material-icons">phone</i>
  </a>
</div>

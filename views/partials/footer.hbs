<footer class="page-footer grey darken-4">
  <div class="container">
    <div class="row">
      <div class="col s12 m6">
        <h5 class="white-text">{{t "footer.title"}}</h5>
        <p class="grey-text text-lighten-3">{{t "footer.description"}}</p>
      </div>
      <div class="col s12 m6">
        <h6 class="white-text">{{t "footer.navigation"}}</h6>
        <ul>
          <li><a class="grey-text text-lighten-3" href="/">{{t "nav.home"}}</a></li>
          <li><a class="grey-text text-lighten-3" href="/villages">{{t "nav.villages"}}</a></li>
          <li><a class="grey-text text-lighten-3" href="/objects">{{t "nav.objects"}}</a></li>
          <li><a class="grey-text text-lighten-3" href="/contacts">{{t "nav.contacts"}}</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-copyright">
    <div class="container">© {{currentYear}} {{t "footer.title"}}</div>
  </div>
</footer>

<footer class="page-footer">
  <div class="container footer-main">
    <div class="footer-col footer-col--about">
      <h5>{{t "footer.title"}}</h5>
      <p>{{t "footer.description"}}</p>
    </div>

    <div class="footer-col footer-col--nav">
      <h6>{{t "footer.navigation"}}</h6>
      <ul>
        <li><a href="/">{{t "nav.home"}}</a></li>
        <li><a href="/villages">{{t "nav.villages"}}</a></li>
        <li><a href="/objects">{{t "nav.objects"}}</a></li>
        <li><a href="/contacts">{{t "nav.contacts"}}</a></li>
      </ul>
    </div>

    <div class="footer-col footer-col--villages">
      <h6>{{t "footer.villagesTitle"}}</h6>
      <ul class="footer-villages-list">
        <li><a href="/villages/barviha-luxury-village">{{t "footer.village1"}}</a></li>
        <li><a href="/villages/zhukovka">{{t "footer.village2"}}</a></li>
        <li><a href="/villages/podushkino">{{t "footer.village3"}}</a></li>
        <li><a href="/villages/razdory">{{t "footer.village4"}}</a></li>
        <li><a href="/villages/usovo">{{t "footer.village5"}}</a></li>
      </ul>
    </div>

    <div class="footer-col footer-col--presentation">
      <h6>{{t "footer.presentationTitle"}}</h6>
      <div class="footer-presentation-card">
        <img src="/media/images/houses/ex1.png" alt="{{t "home.presentationCoverAlt"}}" />
        <button class="presentation-inline-btn" type="button" data-open-presentation-modal data-source="footer_presentation">
          {{t "home.presentationCta"}}
        </button>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <div class="footer-bottom__left">&copy; {{currentYear}} {{t "footer.title"}}</div>
      <div class="footer-bottom__right">
        <span class="footer-status">{{t "common.workingNow"}}</span>
        <a class="footer-phone" href='{{t "contacts.phoneHref"}}'>{{t "contacts.phone"}}</a>
      </div>
    </div>
  </div>
</footer>


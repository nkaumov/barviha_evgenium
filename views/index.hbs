<section class="container section life-gallery-section">
  <h2 class="section-title">{{t "home.lifeGalleryTitle"}}</h2>
  <div class="life-gallery-grid">
    {{#each lifeGallery}}
      <a class="life-gallery-card" href="/gallery/life">
        <img src="{{image}}" alt="{{title}}" />
        <div class="life-gallery-card__overlay"></div>
        <div class="life-gallery-card__content">
          <h3>{{title}}</h3>
          <p>{{subtitle}}</p>
        </div>
      </a>
    {{/each}}
  </div>
</section>

<section class="container section life-articles-section">
  <h2 class="section-title">{{t "home.lifeArticlesTitle"}}</h2>
  <div class="life-slider-wrap">
    <button class="life-slider-nav life-slider-nav--prev" type="button" aria-label="Предыдущая статья">
      <i class="material-icons">chevron_left</i>
    </button>
    <div class="life-articles-track" id="life-articles-track">
      {{#each lifeArticles}}
        <article class="life-article-card">
          <img src="{{image}}" alt="{{title}}" />
          <div class="life-article-card__content">
            <span class="life-article-card__date">{{date}}</span>
            <h3>{{title}}</h3>
            <p>{{excerpt}}</p>
            <a class="learn-more" href="{{url}}">
              <span class="circle" aria-hidden="true">
                <span class="icon arrow"></span>
              </span>
              <span class="button-text">{{t "objectsPage.moreDetails"}}</span>
            </a>
          </div>
        </article>
      {{/each}}
    </div>
    <button class="life-slider-nav life-slider-nav--next" type="button" aria-label="Следующая статья">
      <i class="material-icons">chevron_right</i>
    </button>
  </div>
</section>

<section class="container section life-testimonials-section">
  <h2 class="section-title">{{t "home.testimonialsTitle"}}</h2>
  <div class="life-slider-wrap">
    <button class="testimonials-nav testimonials-nav--prev" type="button" aria-label="Предыдущая цитата">
      <i class="material-icons">chevron_left</i>
    </button>
    <div class="testimonials-track" id="testimonials-track">
      {{#each testimonials}}
        <article class="testimonial-card">
          <div class="testimonial-card__person">
            <img src="{{image}}" alt="{{name}}" />
            <div>
              <h3>{{name}}</h3>
              <p>{{role}}</p>
            </div>
          </div>
          <blockquote>{{quote}}</blockquote>
        </article>
      {{/each}}
    </div>
    <button class="testimonials-nav testimonials-nav--next" type="button" aria-label="Следующая цитата">
      <i class="material-icons">chevron_right</i>
    </button>
  </div>
</section>

<section class="container section review-form-section" id="request-form">
  <h2 class="section-title">{{t "home.requestFormTitle"}}</h2>
  <div class="review-form-layout">
    <form class="review-form-card" id="review-form" action="#" method="post">
      <input type="hidden" name="requestObject" id="request-object-id" />

      <label class="review-form-field">
        <span>{{t "home.requestNameLabel"}}</span>
        <input type="text" name="name" placeholder="{{t "home.requestNamePlaceholder"}}" required />
      </label>

      <label class="review-form-field">
        <span>{{t "home.requestPhoneLabel"}}</span>
        <input type="tel" name="phone" placeholder="{{t "home.requestPhonePlaceholder"}}" required />
      </label>

      <label class="review-form-field">
        <span>{{t "home.requestMessengerLabel"}}</span>
        <input type="url" name="messenger" placeholder="{{t "home.requestMessengerPlaceholder"}}" required />
      </label>

      <label class="review-form-field">
        <span>{{t "home.requestTextLabel"}}</span>
        <textarea name="text" rows="5" placeholder="{{t "home.requestTextPlaceholder"}}" required></textarea>
      </label>

      <div class="review-submit-wrap">
        <button class="review-submit" type="submit" id="review-submit">
          <span class="review-submit__text">{{t "home.requestSubmitLabel"}}</span>
          <span class="review-submit__progress"></span>
          <svg viewBox="0 0 25 30" aria-hidden="true">
            <path class="review-submit__check" d="M2,19.2C5.9,23.6,9.4,28,9.4,28L23,2" />
          </svg>
        </button>
      </div>
    </form>
  </div>
</section>

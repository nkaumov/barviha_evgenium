<section class="hero-section" aria-label="Главный баннер">
  <video
    class="hero-section__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
  >
    <source src="/media/video/banner.mp4" type="video/mp4" />
  </video>
  <div class="hero-section__overlay"></div>

  <div class="container hero-section__content">
    <h1 class="hero-title">{{t "home.heroTitle"}}</h1>
    <p class="hero-subtitle">{{t "home.heroSubtitle"}}</p>
    <div class="hero-actions">
      <a class="hero-cta hero-cta--primary" href="/objects">{{t "home.ctaObjects"}}</a>
      <a class="hero-cta hero-cta--secondary" href="#request-form">{{t "home.ctaRequest"}}</a>
    </div>
  </div>
</section>

<section class="container section villages-roulette-section">
  <h2 class="section-title">{{t "home.villagesCarouselTitle"}}</h2>
  <div class="villages-roulette-wrap">
    <button class="villages-roulette-nav villages-roulette-nav--prev" type="button" aria-label="Предыдущий поселок">
      <i class="material-icons">chevron_left</i>
    </button>
    <div class="villages-roulette" id="villages-roulette">
      {{#each villagesCarousel}}
        <a class="village-roulette-card" href="/villages/{{slug}}">
          <img class="village-roulette-card__image" src="{{image}}" alt="{{name}}" draggable="false" />
          <div class="village-roulette-card__overlay"></div>
          <div class="village-roulette-card__content">
            <h3>{{name}}</h3>
            <p>{{t "villagesPage.housesCount"}} {{housesCount}}</p>
          </div>
        </a>
      {{/each}}
    </div>
    <button class="villages-roulette-nav villages-roulette-nav--next" type="button" aria-label="Следующий поселок">
      <i class="material-icons">chevron_right</i>
    </button>
  </div>
  <div class="villages-roulette-section__actions">
    <a class="learn-more" href="/villages">
      <span class="circle" aria-hidden="true">
        <span class="icon arrow"></span>
      </span>
      <span class="button-text">{{t "villagesPage.details"}}</span>
    </a>
  </div>
</section>

